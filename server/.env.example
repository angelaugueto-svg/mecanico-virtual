# Mecánico Virtual Motolab AA — variables de entorno (ejemplo, sin valores reales)
# Copiar a .env y rellenar. Nunca subir el .env real.

# Postgres (obligatorio). Local: postgres://usuario:clave@localhost:5432/mecanico_virtual
DATABASE_URL=

# Cheo (Anthropic). Opcional: sin ANTHROPIC_API_KEY el servidor arranca en modo STUB
# (respuestas de ejemplo deterministas con el catálogo real).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Correo SMTP para avisar a motolabaa@gmail.com (registro y pagos).
# Sin SMTP, el servidor registra el intento en el log y sigue (nunca bloquea).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Puerto del servidor
PORT=3000

# Días que dura la sesión en el teléfono del cliente
SESSION_DAYS=30

# Google Sheets del catálogo «Motolab AA - Productos» (pestaña Sheet1)
CATALOG_SHEET_ID=1qiTU_xBfl25SEGgIs6FTnmlESaD6oFiPDip9W-Od7PA
